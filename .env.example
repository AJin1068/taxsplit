POSTGRES_USER=llm
# 로컬 연습용 값. 비우면 Postgres 컨테이너가 "superuser password is not specified"로 바로 꺼진다
POSTGRES_PASSWORD=taxsplit
POSTGRES_DB=taxsplit
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://llm:taxsplit@localhost:5432/taxsplit
# 대화·LLM 호출 기록 저장 위치. memory: 서버를 끄면 사라짐 / postgres: DATABASE_URL에 저장
STORAGE=memory
# LLM (값은 비워 둔다. 키는 .env에만 넣는다)
# fake: 키 없이 정해진 답 / anthropic: 실제 Claude API
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
# 채점(judge)용 GPT 키. 평가 하네스 --judge에서만 쓴다 (ADR-0006)
OPENAI_API_KEY=
# 비우면 Anthropic 기본 주소. 게이트웨이가 생기면 게이트웨이 주소로 바꾼다
LLM_BASE_URL=
LLM_CONNECT_TIMEOUT=5
LLM_READ_TIMEOUT=60
LLM_TOTAL_TIMEOUT=120
LLM_MAX_TOKENS=4096
# 호출 종류별 모델. 비우면 LLM_MODEL_DEFAULT (ADR-0006)
LLM_MODEL_DEFAULT=claude-sonnet-5-5
LLM_MODEL_MAIN_AGENT=
LLM_MODEL_PDF_EXTRACT=claude-haiku-5-5
LLM_MODEL_SIM_USER=claude-haiku-5-5
LLM_MODEL_VERIFIER=
# 채점은 GPT(OpenAI). 비우면 gpt-6.2-sol (2026-11-19 OpenAI 가격 페이지에서 확인)
LLM_MODEL_JUDGE=gpt-6.2-sol
# 근거 찾기 방법(keyword / vector / hybrid). 비우면 --extra rag가 깔려 있으면 hybrid, 아니면 keyword
RAG_METHOD=
# 메인 에이전트 한 턴 최대 AI 호출 수(도구 결과를 돌려주는 호출 포함, 운영값)
AGENT_MAX_LLM_CALLS_PER_TURN=10
